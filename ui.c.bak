    gtk_widget_add_css_class(w->chart_doughnut, "proxy-chart");
    gtk_drawing_area_set_draw_func(GTK_DRAWING_AREA(w->chart_doughnut), NULL, NULL, NULL);
    gtk_box_append(GTK_BOX(card), w->chart_doughnut);

    GtkWidget *chart2_label = gtk_label_new(NULL);
    gtk_label_set_markup(GTK_LABEL(chart2_label),
        "<span size='small' weight='bold' foreground='" TEXT_SECONDARY "'>Daily Cost (30 days)</span>");
    gtk_widget_set_halign(chart2_label, GTK_ALIGN_START);
    gtk_widget_set_margin_top(chart2_label, 12);
    gtk_box_append(GTK_BOX(card), chart2_label);

    w->chart_daily_bar = gtk_drawing_area_new();
    gtk_widget_set_size_request(w->chart_daily_bar, -1, 300);
    gtk_widget_add_css_class(w->chart_daily_bar, "proxy-chart");
    gtk_drawing_area_set_draw_func(GTK_DRAWING_AREA(w->chart_daily_bar), NULL, NULL, NULL);
    gtk_box_append(GTK_BOX(card), w->chart_daily_bar);

    GtkWidget *sep3 = gtk_separator_new(GTK_ORIENTATION_HORIZONTAL);
    gtk_widget_set_opacity(sep3, 0.2);
    gtk_box_append(GTK_BOX(card), sep3);

    // Today section
    GtkWidget *today_label = gtk_label_new(NULL);
    gtk_label_set_markup(GTK_LABEL(today_label),
        "<span size='small' weight='bold' foreground='" TEXT_SECONDARY "'>Today</span>");
    gtk_widget_set_halign(today_label, GTK_ALIGN_START);
    gtk_box_append(GTK_BOX(card), today_label);

    w->today_box = gtk_box_new(GTK_ORIENTATION_VERTICAL, 4);
    gtk_box_append(GTK_BOX(card), w->today_box);

    GtkWidget *sep4 = gtk_separator_new(GTK_ORIENTATION_HORIZONTAL);
    gtk_widget_set_opacity(sep4, 0.2);
    gtk_box_append(GTK_BOX(card), sep4);

    // Recent section
    GtkWidget *recent_label = gtk_label_new(NULL);
    gtk_label_set_markup(GTK_LABEL(recent_label),
        "<span size='small' weight='bold' foreground='" TEXT_SECONDARY "'>Recent Requests</span>");
    gtk_widget_set_halign(recent_label, GTK_ALIGN_START);
    gtk_box_append(GTK_BOX(card), recent_label);

    w->recent_box = gtk_box_new(GTK_ORIENTATION_VERTICAL, 4);
    gtk_box_append(GTK_BOX(card), w->recent_box);

    w->load_more_btn = gtk_button_new_with_label("Load More");
    gtk_widget_set_halign(w->load_more_btn, GTK_ALIGN_CENTER);
    gtk_widget_set_margin_top(w->load_more_btn, 8);
    g_signal_connect(w->load_more_btn, "clicked", G_CALLBACK(on_load_more_clicked), w);
    gtk_box_append(GTK_BOX(card), w->load_more_btn);

    // Detail view (hidden by default)
    w->detail_box = gtk_box_new(GTK_ORIENTATION_VERTICAL, 12);
    gtk_widget_set_visible(w->detail_box, FALSE);
    gtk_widget_set_margin_top(w->detail_box, 12);
    gtk_box_append(GTK_BOX(card), w->detail_box);

    // Back button (persistent, not cleared)
    GtkWidget *back_btn = gtk_button_new_with_label("← Back to Requests");
    gtk_widget_add_css_class(back_btn, "back-btn");
    gtk_widget_set_halign(back_btn, GTK_ALIGN_START);
    g_signal_connect(back_btn, "clicked", G_CALLBACK(on_back_from_detail_clicked), w);
    gtk_box_append(GTK_BOX(w->detail_box), back_btn);

    GtkWidget *sep = gtk_separator_new(GTK_ORIENTATION_HORIZONTAL);
    gtk_box_append(GTK_BOX(w->detail_box), sep);

    w->detail_content = gtk_box_new(GTK_ORIENTATION_VERTICAL, 8);
    gtk_box_append(GTK_BOX(w->detail_box), w->detail_content);




    w->recent_limit = 5;


    w->last_updated_label = gtk_label_new(NULL);
    gtk_widget_set_halign(w->last_updated_label, GTK_ALIGN_CENTER);
    gtk_widget_set_margin_top(w->last_updated_label, 8);
    gtk_box_append(GTK_BOX(card), w->last_updated_label);

    return w->card_revealer;
}

// Forward declarations for proxy helper functions
static const char *get_today_date(void);
static void draw_proxy_doughnut_chart(GtkDrawingArea *area, cairo_t *cr,
                                       int width, int height, gpointer user_data);
static void draw_proxy_daily_bar_chart(GtkDrawingArea *area, cairo_t *cr,
                                        int width, int height, gpointer user_data);

static void on_back_from_detail_clicked(GtkButton *button, gpointer user_data) {
    ProxyCardWidgets *w = (ProxyCardWidgets *)user_data;
    w->showing_detail = FALSE;
    gtk_widget_set_visible(w->detail_box, FALSE);
    gtk_widget_set_visible(w->recent_box, TRUE);
    gtk_widget_set_visible(w->load_more_btn, TRUE);
    clear_box(w->detail_content);
}

static void show_request_detail_inline(ProxyCardWidgets *w, long request_id) {
    w->showing_detail = TRUE;
    gtk_widget_set_visible(w->recent_box, FALSE);
    gtk_widget_set_visible(w->load_more_btn, FALSE);
    gtk_widget_set_visible(w->detail_box, TRUE);


    GtkWidget *loading = gtk_label_new("Loading...");
    gtk_widget_set_halign(loading, GTK_ALIGN_CENTER);
    gtk_box_append(GTK_BOX(w->detail_content), loading);

    while (g_main_context_iteration(NULL, FALSE));

    ProxyRequestDetail *detail = proxy_query_request_detail(request_id);
    clear_box(w->detail_content);

    if (!detail) {
        GtkWidget *error = gtk_label_new(NULL);
        gtk_label_set_markup(GTK_LABEL(error),
            "<span size='medium' foreground='" DANGER_RED "'>Failed to load request details</span>");
        gtk_box_append(GTK_BOX(w->detail_content), error);
        return;
    }

    GtkWidget *stats_grid = gtk_grid_new();
    gtk_grid_set_row_spacing(GTK_GRID(stats_grid), 8);
    gtk_grid_set_column_spacing(GTK_GRID(stats_grid), 16);
    gtk_box_append(GTK_BOX(w->detail_content), stats_grid);

    int row = 0;

    GtkWidget *id_label = gtk_label_new(NULL);
    gtk_label_set_markup(GTK_LABEL(id_label),
        "<span size='medium' foreground='" TEXT_SECONDARY "'>Request ID:</span>");
    gtk_widget_set_halign(id_label, GTK_ALIGN_START);
    gtk_grid_attach(GTK_GRID(stats_grid), id_label, 0, row, 1, 1);

    char id_val[256];
    snprintf(id_val, sizeof(id_val),
        "<span size='medium' weight='bold' foreground='" TEXT_PRIMARY "'>#%ld</span>", detail->id);
    GtkWidget *id_val_label = gtk_label_new(NULL);
    gtk_label_set_markup(GTK_LABEL(id_val_label), id_val);
    gtk_widget_set_halign(id_val_label, GTK_ALIGN_START);
    gtk_grid_attach(GTK_GRID(stats_grid), id_val_label, 1, row, 1, 1);
    row++;

    GtkWidget *model_label = gtk_label_new(NULL);
    gtk_label_set_markup(GTK_LABEL(model_label),
        "<span size='medium' foreground='" TEXT_SECONDARY "'>Model:</span>");
    gtk_widget_set_halign(model_label, GTK_ALIGN_START);
    gtk_grid_attach(GTK_GRID(stats_grid), model_label, 0, row, 1, 1);

    char model_val[256];
    snprintf(model_val, sizeof(model_val),
        "<span size='medium' weight='bold' foreground='" ALIBABA_ACCENT "'>%s</span>", detail->model);
    GtkWidget *model_val_label = gtk_label_new(NULL);
    gtk_label_set_markup(GTK_LABEL(model_val_label), model_val);
    gtk_widget_set_halign(model_val_label, GTK_ALIGN_START);
    gtk_grid_attach(GTK_GRID(stats_grid), model_val_label, 1, row, 1, 1);
    row++;

    GtkWidget *time_label = gtk_label_new(NULL);
    gtk_label_set_markup(GTK_LABEL(time_label),
        "<span size='medium' foreground='" TEXT_SECONDARY "'>Timestamp:</span>");
    gtk_widget_set_halign(time_label, GTK_ALIGN_START);
    gtk_grid_attach(GTK_GRID(stats_grid), time_label, 0, row, 1, 1);

    char time_val[128];
    snprintf(time_val, sizeof(time_val),
        "<span size='medium' foreground='" TEXT_PRIMARY "'>%s</span>", detail->timestamp);
    GtkWidget *time_val_label = gtk_label_new(NULL);
    gtk_label_set_markup(GTK_LABEL(time_val_label), time_val);
    gtk_widget_set_halign(time_val_label, GTK_ALIGN_START);
    gtk_grid_attach(GTK_GRID(stats_grid), time_val_label, 1, row, 1, 1);
    row++;

    GtkWidget *status_label = gtk_label_new(NULL);
    gtk_label_set_markup(GTK_LABEL(status_label),
        "<span size='medium' foreground='" TEXT_SECONDARY "'>Status:</span>");
    gtk_widget_set_halign(status_label, GTK_ALIGN_START);
    gtk_grid_attach(GTK_GRID(stats_grid), status_label, 0, row, 1, 1);

    const char *status_color = (detail->status_code >= 200 && detail->status_code < 300) ? SUCCESS_GREEN : DANGER_RED;
    char status_val[128];
    snprintf(status_val, sizeof(status_val),
        "<span size='medium' weight='bold' foreground='%s'>%d</span>"
        "<span size='small' foreground='" TEXT_MUTED "'> · %dms%s</span>",
        status_color, detail->status_code, detail->latency_ms,
        detail->stream ? " · streaming" : "");
    GtkWidget *status_val_label = gtk_label_new(NULL);
    gtk_label_set_markup(GTK_LABEL(status_val_label), status_val);
    gtk_widget_set_halign(status_val_label, GTK_ALIGN_START);
    gtk_grid_attach(GTK_GRID(stats_grid), status_val_label, 1, row, 1, 1);
    row++;

    GtkWidget *sep1 = gtk_separator_new(GTK_ORIENTATION_HORIZONTAL);
    gtk_widget_set_opacity(sep1, 0.2);
    gtk_grid_attach(GTK_GRID(stats_grid), sep1, 0, row, 2, 1);
    row++;

    GtkWidget *token_header = gtk_label_new(NULL);
    gtk_label_set_markup(GTK_LABEL(token_header),
        "<span size='small' weight='bold' foreground='" ALIBABA_ORANGE "'"
        " letter_spacing='1024'>TOKEN BREAKDOWN</span>");
    gtk_widget_set_halign(token_header, GTK_ALIGN_START);
    gtk_grid_attach(GTK_GRID(stats_grid), token_header, 0, row, 2, 1);
    row++;

    const char *token_labels[] = {
        "Prompt Tokens", "Completion Tokens", "Total Tokens",
        "Cached Tokens", "Cache Creation Tokens", "Uncached Input", "Output Tokens"
    };
    long token_values[] = {
        detail->prompt, detail->completion, detail->total_tokens,
        detail->cached, detail->cache_create, detail->uncached_input, detail->output_tokens
    };

    for (int i = 0; i < 7; i++) {
        char lbl[128];
        snprintf(lbl, sizeof(lbl),
            "<span size='small' foreground='" TEXT_SECONDARY "'>%s:</span>", token_labels[i]);
        GtkWidget *lbl_widget = gtk_label_new(NULL);
        gtk_label_set_markup(GTK_LABEL(lbl_widget), lbl);
        gtk_widget_set_halign(lbl_widget, GTK_ALIGN_START);
        gtk_grid_attach(GTK_GRID(stats_grid), lbl_widget, 0, row, 1, 1);

        char val[64];
        snprintf(val, sizeof(val),
            "<span size='small' weight='bold' foreground='" TEXT_PRIMARY "'>%ld</span>", token_values[i]);
        GtkWidget *val_widget = gtk_label_new(NULL);
        gtk_label_set_markup(GTK_LABEL(val_widget), val);
        gtk_widget_set_halign(val_widget, GTK_ALIGN_START);
        gtk_grid_attach(GTK_GRID(stats_grid), val_widget, 1, row, 1, 1);
        row++;
    }

    GtkWidget *sep2 = gtk_separator_new(GTK_ORIENTATION_HORIZONTAL);
    gtk_widget_set_opacity(sep2, 0.2);
    gtk_grid_attach(GTK_GRID(stats_grid), sep2, 0, row, 2, 1);
    row++;

    GtkWidget *cost_header = gtk_label_new(NULL);
    gtk_label_set_markup(GTK_LABEL(cost_header),
        "<span size='small' weight='bold' foreground='" ALIBABA_ORANGE "'"
        " letter_spacing='1024'>COST BREAKDOWN</span>");
    gtk_widget_set_halign(cost_header, GTK_ALIGN_START);
    gtk_grid_attach(GTK_GRID(stats_grid), cost_header, 0, row, 2, 1);
    row++;

    const char *cost_labels[] = {
        "Input Cost", "Output Cost", "Cache Read Cost", "Cache Write Cost", "Total Cost"
    };
    double cost_values[] = {
        detail->input_cost, detail->output_cost, detail->cache_read_cost,
        detail->cache_write_cost, detail->cost
    };

    for (int i = 0; i < 5; i++) {
        char lbl[128];
        snprintf(lbl, sizeof(lbl),
            "<span size='small' foreground='" TEXT_SECONDARY "'>%s:</span>", cost_labels[i]);
        GtkWidget *lbl_widget = gtk_label_new(NULL);
        gtk_label_set_markup(GTK_LABEL(lbl_widget), lbl);
        gtk_widget_set_halign(lbl_widget, GTK_ALIGN_START);
        gtk_grid_attach(GTK_GRID(stats_grid), lbl_widget, 0, row, 1, 1);

        const char *cost_color = (i == 4) ? ALIBABA_ACCENT : TEXT_PRIMARY;
        const char *weight = (i == 4) ? "bold" : "normal";
        char val[256];
        snprintf(val, sizeof(val),
            "<span size='small' weight='%s' foreground='%s'>$%.6f</span>", weight, cost_color, cost_values[i]);
        GtkWidget *val_widget = gtk_label_new(NULL);
        gtk_label_set_markup(GTK_LABEL(val_widget), val);
        gtk_widget_set_halign(val_widget, GTK_ALIGN_START);
        gtk_grid_attach(GTK_GRID(stats_grid), val_widget, 1, row, 1, 1);
        row++;
    }

    GtkWidget *sep3 = gtk_separator_new(GTK_ORIENTATION_HORIZONTAL);
    gtk_widget_set_opacity(sep3, 0.2);
    gtk_box_append(GTK_BOX(w->detail_content), sep3);

    GtkWidget *notebook = gtk_notebook_new();
    gtk_box_append(GTK_BOX(w->detail_content), notebook);

    GtkWidget *req_scroll = gtk_scrolled_window_new();
    gtk_scrolled_window_set_min_content_height(GTK_SCROLLED_WINDOW(req_scroll), 200);
    gtk_widget_set_size_request(req_scroll, -1, 250);

    GtkWidget *req_text = gtk_text_view_new();
    gtk_text_view_set_editable(GTK_TEXT_VIEW(req_text), FALSE);
    gtk_text_view_set_wrap_mode(GTK_TEXT_VIEW(req_text), GTK_WRAP_WORD_CHAR);

    GtkTextBuffer *req_buffer = gtk_text_view_get_buffer(GTK_TEXT_VIEW(req_text));
    if (detail->request_messages) {
        gtk_text_buffer_set_text(req_buffer, detail->request_messages, -1);
    } else {
        gtk_text_buffer_set_text(req_buffer, "(no request messages recorded)", -1);
    }

    gtk_scrolled_window_set_child(GTK_SCROLLED_WINDOW(req_scroll), req_text);
    gtk_notebook_append_page(GTK_NOTEBOOK(notebook), req_scroll, gtk_label_new("Request Messages"));

    GtkWidget *resp_scroll = gtk_scrolled_window_new();
    gtk_scrolled_window_set_min_content_height(GTK_SCROLLED_WINDOW(resp_scroll), 200);
    gtk_widget_set_size_request(resp_scroll, -1, 250);

    GtkWidget *resp_text = gtk_text_view_new();
    gtk_text_view_set_editable(GTK_TEXT_VIEW(resp_text), FALSE);
    gtk_text_view_set_wrap_mode(GTK_TEXT_VIEW(resp_text), GTK_WRAP_WORD_CHAR);

    GtkTextBuffer *resp_buffer = gtk_text_view_get_buffer(GTK_TEXT_VIEW(resp_text));
    if (detail->response_content) {
        gtk_text_buffer_set_text(resp_buffer, detail->response_content, -1);
    } else {
        const char *msg = detail->stream ? "(response content not recorded for streaming requests)" : "(no response content recorded)";
        gtk_text_buffer_set_text(resp_buffer, msg, -1);
    }

    gtk_scrolled_window_set_child(GTK_SCROLLED_WINDOW(resp_scroll), resp_text);
    gtk_notebook_append_page(GTK_NOTEBOOK(notebook), resp_scroll, gtk_label_new("Response Content"));

    proxy_free_request_detail(detail);
}

static void on_load_more_clicked(GtkButton *button, gpointer user_data) {
    ProxyCardWidgets *w = (ProxyCardWidgets *)user_data;
    w->recent_limit += 10;
    update_proxy_card(w);
}

typedef struct {
    long request_id;
    ProxyCardWidgets *widgets;
} RequestClickData;

static void on_recent_request_clicked(GtkGestureClick *gesture, int n_press, double x, double y, gpointer user_data) {
    RequestClickData *data = (RequestClickData *)user_data;
    show_request_detail_inline(data->widgets, data->request_id);
}


void update_proxy_card(ProxyCardWidgets *w) {
    ProxyStatus status = proxy_get_status();

    // Update status
    if (status.running) {
        gtk_widget_remove_css_class(w->status_dot, "stopped");
        gtk_widget_add_css_class(w->status_dot, "running");
        gtk_label_set_text(GTK_LABEL(w->status_text), "Running");
    } else {
        gtk_widget_remove_css_class(w->status_dot, "running");
        gtk_widget_add_css_class(w->status_dot, "stopped");
        gtk_label_set_text(GTK_LABEL(w->status_text), "Stopped");
    }

    // Query summary
    int model_count = 0;
    ProxyModelRow *models = proxy_query_summary(&model_count);

    double total_cost = 0;
    long total_requests = 0;
    long total_input = 0;
    long total_output = 0;
    long total_cached = 0;

    if (models) {
        for (int i = 0; i < model_count; i++) {
            total_cost += models[i].total_cost;
            total_requests += models[i].request_count;
            total_input += models[i].input_tokens;
            total_output += models[i].output_tokens;
            total_cached += models[i].cached;
        }
    }

    // Update summary cards
    char buf[64];
    snprintf(buf, sizeof(buf), "$%.2f", total_cost);
    gtk_label_set_text(GTK_LABEL(w->summary_total_cost), buf);

    snprintf(buf, sizeof(buf), "%ld", total_requests);
    gtk_label_set_text(GTK_LABEL(w->summary_requests), buf);

    double cache_hit_pct = (total_input > 0) ? (total_cached * 100.0 / total_input) : 0;
    snprintf(buf, sizeof(buf), "%.1f%%", cache_hit_pct);
    gtk_label_set_text(GTK_LABEL(w->summary_cache_hit), buf);

    long total_tokens = total_input + total_output;
    snprintf(buf, sizeof(buf), "%ldK", total_tokens / 1000);
    gtk_label_set_text(GTK_LABEL(w->summary_tokens), buf);

    // Update doughnut chart - store persistent copy
    if (w->chart_models) {
        free(w->chart_models);
        w->chart_models = NULL;
    }
    if (models && model_count > 0) {
        w->chart_models = malloc(sizeof(ProxyModelRow) * model_count);
        memcpy(w->chart_models, models, sizeof(ProxyModelRow) * model_count);
        w->chart_models_count = model_count;
    } else {
        w->chart_models_count = 0;
    }
    
    gtk_drawing_area_set_draw_func(GTK_DRAWING_AREA(w->chart_doughnut),
        (GtkDrawingAreaDrawFunc)draw_proxy_doughnut_chart, w->chart_models, NULL);
    gtk_widget_queue_draw(w->chart_doughnut);

    // Update daily bar chart - store persistent copy
    int daily_count = 0;
    ProxyDailyRow *daily = proxy_query_daily_series(30, &daily_count);
    
    if (w->chart_daily) {
        free(w->chart_daily);
        w->chart_daily = NULL;
    }
    if (daily && daily_count > 0) {
        w->chart_daily = malloc(sizeof(ProxyDailyRow) * daily_count);
        memcpy(w->chart_daily, daily, sizeof(ProxyDailyRow) * daily_count);
        w->chart_daily_count = daily_count;
    } else {
        w->chart_daily_count = 0;
    }
    
    gtk_drawing_area_set_draw_func(GTK_DRAWING_AREA(w->chart_daily_bar),
        (GtkDrawingAreaDrawFunc)draw_proxy_daily_bar_chart, w->chart_daily, NULL);
    gtk_widget_queue_draw(w->chart_daily_bar);


    // Update today section
    clear_box(w->today_box);
    ProxyModelRow *today_models = proxy_query_daily_models(get_today_date(), &model_count);
    if (today_models) {
        for (int i = 0; i < model_count; i++) {
            GtkWidget *row = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 8);
            gtk_widget_add_css_class(row, "proxy-model-row");

            GtkWidget *name = gtk_label_new(today_models[i].model);
            gtk_widget_set_hexpand(name, TRUE);
            gtk_widget_set_halign(name, GTK_ALIGN_START);
            gtk_box_append(GTK_BOX(row), name);

            char cost_str[32];
            snprintf(cost_str, sizeof(cost_str), "$%.2f", today_models[i].total_cost);
            GtkWidget *cost = gtk_label_new(cost_str);
            gtk_widget_set_halign(cost, GTK_ALIGN_END);
            gtk_box_append(GTK_BOX(row), cost);

            gtk_box_append(GTK_BOX(w->today_box), row);
        }
        proxy_free_rows(today_models);
    }

    // Update recent section
    clear_box(w->recent_box);
    int recent_count = 0;
    ProxyRequestRow *recent = proxy_query_recent(w->recent_limit, &recent_count);
    if (recent) {
        for (int i = 0; i < recent_count; i++) {
            GtkWidget *row = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 8);
            gtk_widget_add_css_class(row, "proxy-model-row");

            char id_str[32];
            snprintf(id_str, sizeof(id_str), "#%ld", recent[i].id);
            GtkWidget *id = gtk_label_new(id_str);
            gtk_box_append(GTK_BOX(row), id);

            GtkWidget *model = gtk_label_new(recent[i].model);
            gtk_widget_set_hexpand(model, TRUE);
            gtk_widget_set_halign(model, GTK_ALIGN_START);
            gtk_box_append(GTK_BOX(row), model);

            char cost_str[32];
            snprintf(cost_str, sizeof(cost_str), "$%.4f", recent[i].cost);
            GtkWidget *cost = gtk_label_new(cost_str);
            gtk_widget_set_halign(cost, GTK_ALIGN_END);
            gtk_box_append(GTK_BOX(row), cost);

            GtkGesture *click = gtk_gesture_click_new();
            RequestClickData *click_data = g_malloc0(sizeof(RequestClickData));
            click_data->request_id = recent[i].id;
            click_data->widgets = w;
            g_signal_connect(click, "pressed", G_CALLBACK(on_recent_request_clicked), click_data);
            g_object_set_data_full(G_OBJECT(row), "click-data", click_data, g_free);
            gtk_widget_add_controller(row, GTK_EVENT_CONTROLLER(click));


            gtk_box_append(GTK_BOX(w->recent_box), row);
        }
        proxy_free_rows(recent);
    }


    set_timestamp(w->last_updated_label);
    gtk_revealer_set_reveal_child(GTK_REVEALER(w->card_revealer), TRUE);

    if (models) proxy_free_rows(models);
    if (daily) proxy_free_rows(daily);
}

static const char *get_today_date(void) {
    static char buf[16];
    time_t now = time(NULL);
    struct tm *tm = localtime(&now);
    strftime(buf, sizeof(buf), "%Y-%m-%d", tm);
    return buf;
}

static void draw_proxy_doughnut_chart(GtkDrawingArea *area, cairo_t *cr,
                                       int width, int height, gpointer user_data) {
    (void)area;
    ProxyModelRow *models = (ProxyModelRow *)user_data;
    if (!models) return;

    int count = 0;
    double total_cost = 0;
    for (int i = 0; i < 50; i++) {
        if (models[i].model[0] == '\0') break;
        total_cost += models[i].total_cost;
        count++;
    }

    if (count == 0 || total_cost == 0) return;

    // Adjust layout for legend
    double legend_width = 200;
    double chart_area_width = width - legend_width;
    double cx = chart_area_width / 2.0;
    double cy = height / 2.0;
    double outer_r = (height < chart_area_width ? height : chart_area_width) / 2.0 - 20;
    double inner_r = outer_r * 0.6;

    double start_angle = 0;
    const char *colors[] = {
        "#FF6A00", "#FF8133", "#52c41a", "#3b82f6", "#8b5cf6",
        "#ec4899", "#f59e0b", "#10b981", "#06b6d4", "#ef4444"
    };
    int num_colors = 10;

    for (int i = 0; i < count; i++) {
        double slice_angle = (models[i].total_cost / total_cost) * 2 * M_PI;

        const char *hex = colors[i % num_colors];
        if (hex[0] == '#') hex++;
        unsigned int r = 0, g = 0, b = 0;
        sscanf(hex, "%2x%2x%2x", &r, &g, &b);
        cairo_set_source_rgb(cr, r/255.0, g/255.0, b/255.0);

        cairo_move_to(cr, cx, cy);
        cairo_arc(cr, cx, cy, outer_r, start_angle, start_angle + slice_angle);
        cairo_close_path(cr);
        cairo_fill(cr);

        start_angle += slice_angle;
    }

    cairo_set_source_rgb(cr, 0.145, 0.145, 0.145);
    cairo_arc(cr, cx, cy, inner_r, 0, 2 * M_PI);
    cairo_fill(cr);

    char total_str[64];
    snprintf(total_str, sizeof(total_str), "$%.2f", total_cost);
    cairo_set_source_rgb(cr, 0.816, 0.816, 0.816);
    cairo_select_font_face(cr, "Sans", CAIRO_FONT_SLANT_NORMAL, CAIRO_FONT_WEIGHT_BOLD);
    cairo_set_font_size(cr, 18);
    cairo_text_extents_t extents;
    cairo_text_extents(cr, total_str, &extents);
    cairo_move_to(cr, cx - extents.width/2, cy + extents.height/2);
    cairo_show_text(cr, total_str);

    // Draw legend
    double legend_x = chart_area_width + 10;
    double legend_y = 30;
    double box_size = 12;
    double line_height = 24;

    cairo_select_font_face(cr, "Sans", CAIRO_FONT_SLANT_NORMAL, CAIRO_FONT_WEIGHT_NORMAL);
    cairo_set_font_size(cr, 12);

    for (int i = 0; i < count && i < 10; i++) {
        // Draw color box
        const char *hex = colors[i % num_colors];
        if (hex[0] == '#') hex++;
        unsigned int r = 0, g = 0, b = 0;
        sscanf(hex, "%2x%2x%2x", &r, &g, &b);
        cairo_set_source_rgb(cr, r/255.0, g/255.0, b/255.0);
        cairo_rectangle(cr, legend_x, legend_y + i * line_height, box_size, box_size);
        cairo_fill(cr);

        // Draw model name
        cairo_set_source_rgb(cr, 0.816, 0.816, 0.816);
        char label[128];
        snprintf(label, sizeof(label), "%.20s", models[i].model);
        cairo_move_to(cr, legend_x + box_size + 8, legend_y + i * line_height + box_size - 2);
        cairo_show_text(cr, label);
    }

}


static void draw_proxy_daily_bar_chart(GtkDrawingArea *area, cairo_t *cr,
                                        int width, int height, gpointer user_data) {
    (void)area;
    ProxyDailyRow *daily = (ProxyDailyRow *)user_data;
    if (!daily) return;

    int count = 0;
    double max_cost = 0;
    for (int i = 0; i < 50; i++) {
        if (daily[i].day[0] == '\0') break;
        if (daily[i].total_cost > max_cost) max_cost = daily[i].total_cost;
        count++;
    }

    if (count == 0 || max_cost == 0) return;

    double margin_left = 60;
    double margin_bottom = 40;
    double chart_width = width - margin_left - 20;
    double chart_height = height - margin_bottom - 20;
    double bar_width = chart_width / count;

    for (int i = 0; i < count; i++) {
        double bar_height = (daily[i].total_cost / max_cost) * chart_height;
        double x = margin_left + i * bar_width;
        double y = height - margin_bottom - bar_height;

        cairo_set_source_rgb(cr, 1.0, 0.416, 0.0);
        cairo_rectangle(cr, x + 2, y, bar_width - 4, bar_height);
        cairo_fill(cr);

        if (i % 5 == 0) {
            cairo_set_source_rgb(cr, 0.667, 0.667, 0.667);
            cairo_select_font_face(cr, "Sans", CAIRO_FONT_SLANT_NORMAL, CAIRO_FONT_WEIGHT_NORMAL);
            cairo_set_font_size(cr, 10);
            cairo_text_extents_t extents;
            cairo_text_extents(cr, daily[i].day + 5, &extents);
            cairo_move_to(cr, x + bar_width/2 - extents.width/2, height - margin_bottom + 15);
            cairo_show_text(cr, daily[i].day + 5);
        }
    }

    cairo_set_source_rgb(cr, 0.667, 0.667, 0.667);
    cairo_select_font_face(cr, "Sans", CAIRO_FONT_SLANT_NORMAL, CAIRO_FONT_WEIGHT_NORMAL);
    cairo_set_font_size(cr, 10);

    for (int i = 0; i <= 4; i++) {
        double y = height - margin_bottom - (i * chart_height / 4);
        double value = max_cost * i / 4;
        char label[32];
        snprintf(label, sizeof(label), "$%.1f", value);
        cairo_text_extents_t extents;
        cairo_text_extents(cr, label, &extents);
        cairo_move_to(cr, margin_left - extents.width - 10, y + extents.height/2);
        cairo_show_text(cr, label);
    }
}


/* ── Timer callback ──────────────────────────────────────────────── */

static gboolean on_timer(gpointer user_data) {
    (void)user_data;
    start_fetch(&billing_card);
    start_detailed_fetch(&services_card, &models_beijing_card, &models_singapore_card);
    start_historical_fetch(&historical_card);
    return G_SOURCE_CONTINUE;
}

/* ── Settings dialog ─────────────────────────────────────────────── */

typedef struct {
    GtkWidget *id_entry;
    GtkWidget *secret_entry;
    GtkWidget *dialog;
} SettingsData;

static GtkWidget *settings_dialog = NULL;

static void on_settings_dialog_destroyed(GtkWidget *widget, gpointer user_data) {
    settings_dialog = NULL;
}

static void on_save_settings(GtkButton *button, gpointer user_data) {
    SettingsData *sd = (SettingsData *)user_data;
    const char *key_id = gtk_editable_get_text(GTK_EDITABLE(sd->id_entry));
    const char *key_secret = gtk_editable_get_text(GTK_EDITABLE(sd->secret_entry));
    save_credentials(key_id, key_secret);
    start_fetch(&billing_card);
    start_detailed_fetch(&services_card, &models_beijing_card, &models_singapore_card);
    start_historical_fetch(&historical_card);
    gtk_window_destroy(GTK_WINDOW(sd->dialog));
}

static void on_settings_clicked(GtkButton *button, gpointer user_data) {
    if (settings_dialog) {
        gtk_window_present(GTK_WINDOW(settings_dialog));
        return;
    }

    GtkWidget *parent = GTK_WIDGET(user_data);

    GtkWidget *dialog = gtk_window_new();
    gtk_window_set_title(GTK_WINDOW(dialog), "Settings");
    gtk_window_set_transient_for(GTK_WINDOW(dialog), GTK_WINDOW(parent));
    gtk_window_set_modal(GTK_WINDOW(dialog), TRUE);
    gtk_window_set_default_size(GTK_WINDOW(dialog), 420, -1);
    gtk_window_set_resizable(GTK_WINDOW(dialog), FALSE);
    gtk_widget_add_css_class(dialog, "settings-window");
    g_signal_connect(dialog, "destroy", G_CALLBACK(on_settings_dialog_destroyed), NULL);
    settings_dialog = dialog;

    GtkWidget *box = gtk_box_new(GTK_ORIENTATION_VERTICAL, 12);
    gtk_widget_set_margin_top(box, 24);
    gtk_widget_set_margin_bottom(box, 24);
    gtk_widget_set_margin_start(box, 24);
    gtk_widget_set_margin_end(box, 24);
    gtk_window_set_child(GTK_WINDOW(dialog), box);

    GtkWidget *title = gtk_label_new(NULL);
    gtk_label_set_markup(GTK_LABEL(title),
        "<span size='large' weight='bold' foreground='" ALIBABA_ORANGE "'>API Credentials</span>");
    gtk_widget_set_halign(title, GTK_ALIGN_START);
    gtk_box_append(GTK_BOX(box), title);

    GtkWidget *hint = gtk_label_new(NULL);
    gtk_label_set_markup(GTK_LABEL(hint),
        "<span size='x-small' foreground='" TEXT_MUTED "'>Requires AliyunBSSReadOnlyAccess policy</span>");
    gtk_widget_set_halign(hint, GTK_ALIGN_START);
    gtk_box_append(GTK_BOX(box), hint);

    GtkWidget *sep = gtk_separator_new(GTK_ORIENTATION_HORIZONTAL);
    gtk_widget_set_opacity(sep, 0.2);
    gtk_box_append(GTK_BOX(box), sep);

    GtkWidget *id_label = gtk_label_new(NULL);
    gtk_label_set_markup(GTK_LABEL(id_label),
        "<span size='small' foreground='" TEXT_SECONDARY "'>Access Key ID</span>");
    gtk_widget_set_halign(id_label, GTK_ALIGN_START);
    gtk_box_append(GTK_BOX(box), id_label);

    GtkWidget *id_entry = gtk_entry_new();
    gtk_entry_set_placeholder_text(GTK_ENTRY(id_entry), "LTAI...");
    const char *current_id = get_access_key_id();
    if (strlen(current_id) > 0)
        gtk_editable_set_text(GTK_EDITABLE(id_entry), current_id);
    gtk_box_append(GTK_BOX(box), id_entry);

    GtkWidget *secret_label = gtk_label_new(NULL);
    gtk_label_set_markup(GTK_LABEL(secret_label),
        "<span size='small' foreground='" TEXT_SECONDARY "'>Access Key Secret</span>");
    gtk_widget_set_halign(secret_label, GTK_ALIGN_START);
    gtk_box_append(GTK_BOX(box), secret_label);

    GtkWidget *secret_entry = gtk_entry_new();
    gtk_entry_set_visibility(GTK_ENTRY(secret_entry), FALSE);
    gtk_entry_set_placeholder_text(GTK_ENTRY(secret_entry), "Enter access key secret");
    const char *current_secret = get_access_key_secret();
    if (strlen(current_secret) > 0)
        gtk_editable_set_text(GTK_EDITABLE(secret_entry), current_secret);
    gtk_box_append(GTK_BOX(box), secret_entry);

    GtkWidget *btn_box = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 12);
    gtk_widget_set_halign(btn_box, GTK_ALIGN_END);
    gtk_widget_set_margin_top(btn_box, 8);
    gtk_box_append(GTK_BOX(box), btn_box);

    GtkWidget *cancel_btn = gtk_button_new_with_label("Cancel");
    gtk_widget_add_css_class(cancel_btn, "cancel-btn");
    g_signal_connect_swapped(cancel_btn, "clicked", G_CALLBACK(gtk_window_destroy), dialog);
    gtk_box_append(GTK_BOX(btn_box), cancel_btn);

    GtkWidget *save_btn = gtk_button_new_with_label("Save & Refresh");
    gtk_widget_add_css_class(save_btn, "save-btn");
    SettingsData *sd = g_malloc(sizeof(SettingsData));
    sd->id_entry = id_entry;
    sd->secret_entry = secret_entry;
    sd->dialog = dialog;
    g_object_set_data_full(G_OBJECT(dialog), "settings-data", sd, g_free);
    g_signal_connect(save_btn, "clicked", G_CALLBACK(on_save_settings), sd);
    gtk_box_append(GTK_BOX(btn_box), save_btn);

    gtk_window_present(GTK_WINDOW(dialog));
}

/* ── App builder ─────────────────────────────────────────────────── */

void build_ui(GtkApplication *app) {
    apply_css();

    GtkWidget *window = gtk_application_window_new(app);
    gtk_window_set_title(GTK_WINDOW(window), "Alibaba Cloud Spend");
    gtk_window_set_default_size(GTK_WINDOW(window), 500, 700);

    GtkWidget *main_box = gtk_box_new(GTK_ORIENTATION_VERTICAL, 0);
    gtk_window_set_child(GTK_WINDOW(window), main_box);

    GtkWidget *header = gtk_center_box_new();
    gtk_widget_set_margin_top(header, 16);
    gtk_widget_set_margin_bottom(header, 8);
    gtk_widget_set_margin_start(header, 24);
    gtk_widget_set_margin_end(header, 24);
    gtk_box_append(GTK_BOX(main_box), header);

    GtkWidget *logo = gtk_label_new(NULL);
    gtk_label_set_markup(GTK_LABEL(logo),
        "<span size='x-large' weight='bold' foreground='" ALIBABA_ACCENT "'>Alibaba Cloud</span>");
    gtk_center_box_set_center_widget(GTK_CENTER_BOX(header), logo);

    GtkWidget *gear_btn = gtk_button_new_with_label("\xe2\x9a\x99");
    gtk_widget_add_css_class(gear_btn, "flat");
    gtk_widget_add_css_class(gear_btn, "gear-btn");
    gtk_center_box_set_end_widget(GTK_CENTER_BOX(header), gear_btn);
    g_signal_connect(gear_btn, "clicked", G_CALLBACK(on_settings_clicked), window);

    GtkWidget *notebook = gtk_notebook_new();
    gtk_widget_set_vexpand(notebook, TRUE);
    gtk_box_append(GTK_BOX(main_box), notebook);

    /* Tab 1: Overview (Outstanding + Coupons + Services) */
    GtkWidget *tab1_scroll = gtk_scrolled_window_new();
    gtk_scrolled_window_set_policy(GTK_SCROLLED_WINDOW(tab1_scroll),
                                   GTK_POLICY_NEVER, GTK_POLICY_AUTOMATIC);

    GtkWidget *tab1_box = gtk_box_new(GTK_ORIENTATION_VERTICAL, 20);
    gtk_widget_set_margin_top(tab1_box, 16);
    gtk_widget_set_margin_bottom(tab1_box, 16);
    gtk_widget_set_margin_start(tab1_box, 24);
    gtk_widget_set_margin_end(tab1_box, 24);
    gtk_scrolled_window_set_child(GTK_SCROLLED_WINDOW(tab1_scroll), tab1_box);

    gtk_box_append(GTK_BOX(tab1_box), create_billing_card(&billing_card));
    gtk_box_append(GTK_BOX(tab1_box), create_services_card(&services_card));

    billing_card.spinner = gtk_spinner_new();
    gtk_widget_set_halign(billing_card.spinner, GTK_ALIGN_CENTER);
    gtk_widget_set_size_request(billing_card.spinner, 32, 32);
    gtk_widget_set_halign(services_card.spinner, GTK_ALIGN_CENTER);
    gtk_widget_set_size_request(services_card.spinner, 32, 32);

    GtkWidget *tab1_label = gtk_label_new("Overview");
    gtk_notebook_append_page(GTK_NOTEBOOK(notebook), tab1_scroll, tab1_label);

    /* Tab 2: AI Models (Beijing + Singapore combined) */
    GtkWidget *tab2_scroll = gtk_scrolled_window_new();
    gtk_scrolled_window_set_policy(GTK_SCROLLED_WINDOW(tab2_scroll),
                                   GTK_POLICY_NEVER, GTK_POLICY_AUTOMATIC);

    GtkWidget *tab2_box = gtk_box_new(GTK_ORIENTATION_VERTICAL, 20);
    gtk_widget_set_margin_top(tab2_box, 16);
    gtk_widget_set_margin_bottom(tab2_box, 16);
    gtk_widget_set_margin_start(tab2_box, 24);
    gtk_widget_set_margin_end(tab2_box, 24);
    gtk_scrolled_window_set_child(GTK_SCROLLED_WINDOW(tab2_scroll), tab2_box);

    gtk_box_append(GTK_BOX(tab2_box), create_models_card(&models_beijing_card, "BEIJING", "Beijing"));
    models_beijing_card.spinner = gtk_spinner_new();
    gtk_widget_set_halign(models_beijing_card.spinner, GTK_ALIGN_CENTER);
    gtk_widget_set_size_request(models_beijing_card.spinner, 32, 32);

    gtk_box_append(GTK_BOX(tab2_box), create_models_card(&models_singapore_card, "SINGAPORE", "Singapore"));
    models_singapore_card.spinner = gtk_spinner_new();
    gtk_widget_set_halign(models_singapore_card.spinner, GTK_ALIGN_CENTER);
    gtk_widget_set_size_request(models_singapore_card.spinner, 32, 32);

    GtkWidget *tab2_label = gtk_label_new("AI Models");
    gtk_notebook_append_page(GTK_NOTEBOOK(notebook), tab2_scroll, tab2_label);


    /* Tab 4: Historical */
    GtkWidget *tab4_scroll = gtk_scrolled_window_new();
    gtk_scrolled_window_set_policy(GTK_SCROLLED_WINDOW(tab4_scroll),
                                   GTK_POLICY_NEVER, GTK_POLICY_AUTOMATIC);

    GtkWidget *tab4_box = gtk_box_new(GTK_ORIENTATION_VERTICAL, 20);
    gtk_widget_set_margin_top(tab4_box, 16);
    gtk_widget_set_margin_bottom(tab4_box, 16);
    gtk_widget_set_margin_start(tab4_box, 24);
    gtk_widget_set_margin_end(tab4_box, 24);
    gtk_scrolled_window_set_child(GTK_SCROLLED_WINDOW(tab4_scroll), tab4_box);

    gtk_box_append(GTK_BOX(tab4_box), create_historical_card(&historical_card));

    historical_card.spinner = gtk_spinner_new();
    gtk_widget_set_halign(historical_card.spinner, GTK_ALIGN_CENTER);
    gtk_widget_set_size_request(historical_card.spinner, 32, 32);

    GtkWidget *tab4_label = gtk_label_new("History");
    gtk_notebook_append_page(GTK_NOTEBOOK(notebook), tab4_scroll, tab4_label);

    /* Tab 5: Proxy */
    GtkWidget *tab5_scroll = gtk_scrolled_window_new();
    gtk_scrolled_window_set_policy(GTK_SCROLLED_WINDOW(tab5_scroll),
                                   GTK_POLICY_NEVER, GTK_POLICY_AUTOMATIC);

    GtkWidget *tab5_box = gtk_box_new(GTK_ORIENTATION_VERTICAL, 20);
    gtk_widget_set_margin_top(tab5_box, 16);
    gtk_widget_set_margin_bottom(tab5_box, 16);
    gtk_widget_set_margin_start(tab5_box, 24);
    gtk_widget_set_margin_end(tab5_box, 24);
    gtk_scrolled_window_set_child(GTK_SCROLLED_WINDOW(tab5_scroll), tab5_box);

    gtk_box_append(GTK_BOX(tab5_box), create_proxy_card(&proxy_card));

    GtkWidget *tab5_label = gtk_label_new("Proxy");
    gtk_notebook_append_page(GTK_NOTEBOOK(notebook), tab5_scroll, tab5_label);

    /* Start proxy update timer */
    g_timeout_add_seconds(2, (GSourceFunc)update_proxy_card, &proxy_card);

    gtk_window_present(GTK_WINDOW(window));

    start_fetch(&billing_card);
    start_detailed_fetch(&services_card, &models_beijing_card, &models_singapore_card);
    start_historical_fetch(&historical_card);
    g_timeout_add_seconds(UPDATE_INTERVAL_S, on_timer, NULL);
}
