    // Requests card
    GtkWidget *req_card = gtk_box_new(GTK_ORIENTATION_VERTICAL, 4);
    gtk_widget_add_css_class(req_card, "proxy-summary-card");
    w->summary_requests = gtk_label_new("0");
    gtk_widget_add_css_class(w->summary_requests, "proxy-summary-value");
    gtk_box_append(GTK_BOX(req_card), w->summary_requests);
    GtkWidget *req_label = gtk_label_new("Requests");
    gtk_widget_add_css_class(req_label, "proxy-summary-label");
    gtk_box_append(GTK_BOX(req_card), req_label);
    gtk_grid_attach(GTK_GRID(summary_grid), req_card, 1, 0, 1, 1);

    // Cache hit card
    GtkWidget *cache_card = gtk_box_new(GTK_ORIENTATION_VERTICAL, 4);
    gtk_widget_add_css_class(cache_card, "proxy-summary-card");
    w->summary_cache_hit = gtk_label_new("0%");
    gtk_widget_add_css_class(w->summary_cache_hit, "proxy-summary-value");
    gtk_box_append(GTK_BOX(cache_card), w->summary_cache_hit);
    GtkWidget *cache_label = gtk_label_new("Cache Hit");
    gtk_widget_add_css_class(cache_label, "proxy-summary-label");
    gtk_box_append(GTK_BOX(cache_card), cache_label);
    gtk_grid_attach(GTK_GRID(summary_grid), cache_card, 2, 0, 1, 1);

    // Tokens card
    GtkWidget *tok_card = gtk_box_new(GTK_ORIENTATION_VERTICAL, 4);
